# n8n core (optional but recommended for production)
N8N_ENCRYPTION_KEY=replace_with_a_secure_random_string_at_least_32_chars
GENERIC_TIMEZONE=Asia/Taipei
TZ=Asia/Taipei

# --- External AI (Workflow 01 / 02) ---
# Create credentials in n8n UI instead of (or in addition to) env:
# OpenAI / Anthropic / etc. → Credentials → OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# --- Telegram (Workflow 01) ---
# Create Bot via @BotFather, get token; chat_id via @userinfobot or getUpdates
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Notion (Workflow 02) ---
# Create Integration at https://www.notion.so/my-integrations
# Share the target database with the integration
NOTION_API_KEY=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# --- Ollama (Workflow 03, same Docker network) ---
# Inside n8n container use service name:
OLLAMA_BASE_URL=http://ollama:11434
# If n8n runs on host and Ollama in Docker, or vice versa, use:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# or http://localhost:11434
